+void AccountSetupCommandLineManager::setupAccountFromEnvironment()
+{
+    const auto userId = qEnvironmentVariable("NC_USER");
+    const auto appPassword = qEnvironmentVariable("NC_PASSWORD");
+    const auto serverUrl = QUrl(qEnvironmentVariable("NC_SERVER_URL"));
+    const auto localDirPath = qEnvironmentVariable("NC_LOCAL_DIR");
+
+    // Half an account is worse than none: an account without something to authenticate with,
+    // or one syncing into the wrong folder, would have to be removed by hand.
+    if (userId.isEmpty() || appPassword.isEmpty() || localDirPath.isEmpty() || !serverUrl.isValid()
+        || !serverUrl.scheme().startsWith(QLatin1String("http"))) {
+        qCInfo(lcAccountSetupCommandLineManager) << "The environment does not name an account to set up, proceeding with the wizard";
+        return;
+    }
+
+    qCInfo(lcAccountSetupCommandLineManager) << QStringLiteral("No account is configured and the environment names one for %1, attempting setup...").arg(userId);
+
+    // The fuse plugin is this build's best available virtual-files mode, and the store it
+    // serves is the folder named in the environment.
+    const auto accountSetupJob = new AccountSetupFromCommandLineJob(appPassword, userId, serverUrl, localDirPath, true, QStringLiteral("/"), nullptr);
+    accountSetupJob->setQuitsApplicationWhenFinished(false);
+
+    // The account only exists once the server has accepted the credentials and the folder has
+    // been created, both of which the job reports through finished(). Starting the session
+    // afterwards keeps a client that is about to be provisioned from coming up as a wizard.
+    QEventLoop accountSetupLoop;
+    QObject::connect(accountSetupJob, &AccountSetupFromCommandLineJob::finished, &accountSetupLoop, &QEventLoop::quit);
+    QTimer::singleShot(accountSetupFromEnvironmentTimeoutMs, &accountSetupLoop, &QEventLoop::quit);
+
+    if (accountSetupJob->handleAccountSetupFromCommandLine()) {
+        accountSetupLoop.exec();
+    }
 }
+
