+Optional<PinState> pinStateFromString(const QString &str)
+{
+    if (str == QLatin1String("unspecified")) {
+        return PinState::Unspecified;
+    } else if (str == QLatin1String("alwayslocal")) {
+        return PinState::AlwaysLocal;
+    } else if (str == QLatin1String("onlineonly")) {
+        return PinState::OnlineOnly;
+    }
+    return {};
+}
