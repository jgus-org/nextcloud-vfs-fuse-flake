+OCC::Folder *folderForSocketPath(const QString &path, QString *rootPath = nullptr)
+{
+    const auto cleanedPath = QDir::cleanPath(path);
+    const auto containsPath = [&cleanedPath](const QString &candidate) {
+        const auto cleanedCandidate = QDir::cleanPath(candidate);
+        return cleanedPath == cleanedCandidate || cleanedPath.startsWith(cleanedCandidate + QLatin1Char('/'));
+    };
+
+    if (auto *folder = OCC::FolderMan::instance()->folderForPath(cleanedPath)) {
+        if (rootPath) {
+            *rootPath = folder->cleanPath();
+        }
+        return folder;
+    }
+
+    for (auto *folder : OCC::FolderMan::instance()->map()) {
+        if (containsPath(folder->userFacingPath())) {
+            if (rootPath) {
+                *rootPath = QDir::cleanPath(folder->userFacingPath());
+            }
+            return folder;
+        }
+    }
+    return nullptr;
+}
+
